<script is:inline>
  (function () {
    function renderMermaid() {
      var blocks = document.querySelectorAll(
        'pre[data-language="mermaid"], pre code.language-mermaid'
      );
      if (!blocks.length) return;

      var script = document.createElement('script');
      script.type = 'module';
      script.textContent = [
        "import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';",
        "",
        "const isDark = !document.documentElement.hasAttribute('data-theme');",
        "mermaid.initialize({",
        "  startOnLoad: false,",
        "  theme: isDark ? 'dark' : 'default',",
        "  themeVariables: isDark",
        "    ? { primaryColor: '#2a4a2a', primaryTextColor: '#e0e0e0', lineColor: '#4a7a4a' }",
        "    : { primaryColor: '#e8f5e8', primaryTextColor: '#1a2b1a', lineColor: '#3a6a3a' },",
        "});",
        "",
        "const pres = document.querySelectorAll('pre[data-language=\"mermaid\"]');",
        "const codes = document.querySelectorAll('pre > code.language-mermaid');",
        "const targets = pres.length ? pres : codes;",
        "",
        "let i = 0;",
        "for (const el of targets) {",
        "  const code = el.tagName === 'PRE' ? el.textContent : el.textContent;",
        "  const pre = el.tagName === 'PRE' ? el : el.parentElement;",
        "  const container = document.createElement('div');",
        "  container.classList.add('mermaid-container');",
        "  try {",
        "    const { svg } = await mermaid.render('mermaid-' + i++, code.trim());",
        "    container.innerHTML = svg;",
        "    pre.replaceWith(container);",
        "  } catch (e) {",
        "    console.warn('Mermaid render failed:', e);",
        "  }",
        "}",
      ].join('\n');
      document.body.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  })();
</script>

<style is:global>
  .mermaid-container {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin: var(--space-4) 0;
    overflow-x: auto;
    text-align: center;
  }
  .mermaid-container svg {
    max-width: 100%;
    height: auto;
  }
</style>
